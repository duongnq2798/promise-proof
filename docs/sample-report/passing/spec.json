{
  "$schema": "../../schema/spec.schema.json",
  "schemaVersion": "1",
  "id": "saved-contact",
  "revision": 2,
  "goal": "A submitted contact is saved and remains available after reload",
  "baseUrl": "http://127.0.0.1:4173",
  "environment": "local test",
  "preconditions": [
    "Run npm run demo. Contact records are isolated by a synthetic fixture session and live in memory until restart. Revision 2 adds an absence precondition to prevent stale-record evidence."
  ],
  "requiredEnv": [],
  "tags": [],
  "metadata": {},
  "timeoutMs": 5000,
  "evidence": {
    "screenshots": true,
    "trace": true,
    "mask": []
  },
  "steps": [
    {
      "id": "open",
      "description": "Open the contact form",
      "context": "default",
      "type": "navigate",
      "url": "/form"
    },
    {
      "id": "absent",
      "description": "This isolated fixture begins without the expected contact",
      "context": "default",
      "url": "/api/contacts?email=ada@example.test",
      "status": 200,
      "headers": {},
      "json": {
        "path": "record",
        "equals": null
      },
      "type": "api"
    },
    {
      "id": "name",
      "description": "Enter the synthetic name",
      "context": "default",
      "locator": {
        "label": "Name",
        "exact": true
      },
      "type": "fill",
      "value": "Ada Example"
    },
    {
      "id": "email",
      "description": "Enter the synthetic email",
      "context": "default",
      "locator": {
        "label": "Email",
        "exact": true
      },
      "type": "fill",
      "value": "ada@example.test"
    },
    {
      "id": "submit",
      "description": "Save the contact",
      "context": "default",
      "locator": {
        "role": "button",
        "name": "Save contact",
        "exact": true
      },
      "type": "click"
    },
    {
      "id": "ui",
      "description": "The UI confirms success",
      "context": "default",
      "locator": {
        "role": "status",
        "exact": true
      },
      "type": "text",
      "equals": "Success"
    },
    {
      "id": "reload",
      "description": "Reload the form before checking persistence",
      "context": "default",
      "type": "navigate",
      "url": "/form"
    },
    {
      "id": "persisted",
      "description": "The API confirms the submitted record independently",
      "context": "default",
      "url": "/api/contacts?email=ada@example.test",
      "status": 200,
      "headers": {},
      "json": {
        "path": "record",
        "equals": {
          "name": "Ada Example",
          "email": "ada@example.test"
        }
      },
      "type": "api"
    },
    {
      "id": "errors",
      "description": "No browser errors were observed",
      "context": "default",
      "type": "noErrors"
    }
  ],
  "cleanup": []
}
